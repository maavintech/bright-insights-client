# Local development (uncomment when running bi-server on your machine):
# VITE_API_URL=http://localhost:5001/api

# Production. Must be https:// — the Amplify site is served over HTTPS and
# browsers block requests from an HTTPS page to an HTTP origin (mixed content).
# TLS is terminated by Caddy on 443, which reverse-proxies to Node on 5010,
# so there is no port in this URL. See bi-server/DEPLOYMENT.md.
VITE_API_URL=https://server.brightinsights.in/api
